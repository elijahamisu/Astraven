# Client-side Supabase configuration (safe for browser exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Serverless & Cron Secrets (Vercel Environment Variables only - NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
CRON_SECRET=astraven_cron_secure_secret_token_here

# Afrstar Nigeria Payment API v2 (Vercel Environment Variables only - server side)
AFRSTAR_MERCHANT_SN=your_merchant_code
AFRSTAR_MERCHANT_AK=your_merchant_access_key
AFRSTAR_MERCHANT_SK=your_merchant_secret_key
# Optional
AFRSTAR_BASE_URL=https://ngn.afrstar.com
PUBLIC_SITE_URL=https://your-astraven-domain
SUPABASE_URL=https://your-project.supabase.co
